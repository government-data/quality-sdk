# The installation's update agent as a service (decision 0003 step 11):
# `quality-data-agent run` pulls and applies platform versions in rounds,
# a minute apart; it asks the AWS side once an hour. It opens no port.
#
# Installed as /etc/systemd/system/quality-data-agent.service, with the
# binary at /usr/local/bin/quality-data-agent, aws_signing_helper at
# /usr/local/bin/aws_signing_helper and the settings at
# /etc/quality-data/agent.toml (with [api]); then
#
#   systemctl daemon-reload
#   systemctl enable --now quality-data-agent
#   journalctl -u quality-data-agent -f
#
# It runs as root: it drives Docker, writes /opt/quality-data and
# /var/lib/quality-data and reads the enrolment key. An update interrupted
# by a stop or a crash goes on from its state file at the next start.
#
# Sandboxed (decision 0003 point 6; tools/verify/agent-unit.sh checks that
# the Docker CLI, `docker compose` and these paths work inside it): the
# file system is read-only but for the three directories it writes, which
# the installer creates first (/etc/quality-data/internal may come later:
# it holds the certificate for quality-data's internal entry point, which
# the agent renews). Home directories are hidden, so the Compose plugin
# must be installed system-wide (/usr/libexec/docker/cli-plugins or
# /usr/lib/docker/cli-plugins), not under /root/.docker. It keeps root's
# capabilities: a module's key files may belong to another user.

[Unit]
Description=Quality Data update agent
Documentation=https://github.com/quality-data/quality-sdk
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/quality-data-agent run
Restart=on-failure
RestartSec=60
# A step in progress (a dump, `docker compose up --wait`) may take minutes;
# a step stopped half way runs again from the state file.
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=yes
# The image puller's temporary Docker configuration is in /tmp.
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/quality-data /opt/quality-data -/etc/quality-data/internal
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# Docker's socket, AWS and quality-data over IP; netlink for Go's resolver.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
